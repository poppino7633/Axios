# Copy to .env and fill in the key for your provider. .env is git-ignored.

# Which LLM provider to use: gemini, anthropic, openai, huggingface, groq,
# openrouter, mistral, deepseek, ollama, lmstudio, openai_compatible (see providers.py)
AI_PROVIDER=gemini

# API keys: keep one line per provider, the one matching AI_PROVIDER is used.
# (or set AI_API_KEY to override). Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# HF_TOKEN=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=

# Model id for the chosen provider (leave empty for the provider default)
AI_MODEL=gemini-flash-latest

# Tried in order when the main model is overloaded (comma-separated, same provider)
AI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-2.5-flash

# Only needed for openai_compatible, or to point a provider at a different endpoint
# AI_BASE_URL=

# Server address. 0.0.0.0 = reachable by teammates on the same wifi; 127.0.0.1 = this laptop only.
AXIOS_HOST=0.0.0.0
AXIOS_PORT=8765

# Shared team secret: the extension sends it in the X-Axios-Token header.
# Required when AXIOS_HOST is not 127.0.0.1. Share it privately with the team.
AXIOS_TOKEN=pick_a_random_string

# Optional: where the condensed user profile is stored
# AXIOS_PROFILE=/path/to/profile.json
