# Copy to .env and fill in HF_TOKEN. .env is git-ignored.

# Hugging Face token: https://huggingface.co/settings/tokens
# (type "Fine-grained", tick "Make calls to Inference Providers")
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Chat model served by Hugging Face Inference Providers
HF_MODEL=openai/gpt-oss-120b

# Server address. Keep 127.0.0.1 so the server is only reachable from this laptop.
AXIOS_HOST=127.0.0.1
AXIOS_PORT=8765

# Optional: where the condensed user profile is stored
# AXIOS_PROFILE=/path/to/profile.json
