
{
  "manifest_version": 3,
  "name": "Axios",
  "version": "0.1.0",
  "description": "AI-powered job accessibility assistant",
  "permissions": ["tabs"],
  "host_permissions": [
    "https://www.ejobs.ro/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.ejobs.ro/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "Test Axios"
  }
}

