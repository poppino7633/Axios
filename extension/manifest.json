
{
  "manifest_version": 3,
  "name": "Axios",
  "version": "0.2.0",
  "description": "AI-powered job accessibility assistant",

  "permissions": [
    "tabs",
    "storage"
  ],

  "host_permissions": [
    "http://10.200.20.64:8765/*"
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' http://10.200.20.64:8765"
  },

  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "background": {
    "scripts": [
      "background.js"
    ]
  },

  "action": {
    "default_title": "Axios",
    "default_popup": "index.html"
  }
}

